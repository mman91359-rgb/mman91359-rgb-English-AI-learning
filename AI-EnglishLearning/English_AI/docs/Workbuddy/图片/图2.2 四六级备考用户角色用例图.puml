@startuml
' 图2.2 四六级备考用户角色用例图
' 注意：图内不嵌图号，图号与图题统一写在 Word 图注中
left to right direction
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #4A5568
skinparam ArrowThickness 1.1
skinparam usecaseBackgroundColor #EAF1FB
skinparam usecaseBorderColor #5B7DB1
skinparam usecaseBorderThickness 1.1
skinparam rectangleBorderColor #8A9AAE
skinparam rectangleBackgroundColor #FFFFFF
skinparam nodesep 16
skinparam ranksep 30

actor "四六级备考用户" as U

rectangle "Recall 睿考四六级 AI 学习系统" {
  usecase "注册账号" as UC01
  usecase "登录系统" as UC02
  usecase "完成 ELO 能力定级测评" as UC03
  usecase "开展专项练习" as UC04
  usecase "写作练习与 AI 评分" as UC05
  usecase "管理错题本" as UC06
  usecase "管理个人单词本" as UC07
  usecase "执行艾宾浩斯复习任务" as UC08
  usecase "查看学习数据统计" as UC09
  usecase "进行词汇语法练习" as UC10
  usecase "进行听力阅读练习" as UC11
  usecase "进行翻译练习" as UC12
  usecase "查看错题" as UC13
  usecase "筛选错题" as UC14
  usecase "查阅做题记录" as UC15
  usecase "查阅能力雷达图" as UC16
}

U --> UC01
U --> UC02
U --> UC03
U --> UC04
U --> UC05
U --> UC06
U --> UC07
U --> UC08
U --> UC09

UC04 ..> UC10 : include
UC04 ..> UC11 : include
UC04 ..> UC12 : include
UC06 ..> UC13 : include
UC06 ..> UC14 : include
UC09 ..> UC15 : include
UC09 ..> UC16 : include
@enduml
